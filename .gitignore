# =============================================================================
# .gitignore — NQ Evidence Retrieval project
# =============================================================================

# Raw downloaded dataset (large files)
data/raw/
data/processed/

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.code-workspace

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
Thumbs.db

# Large binary outputs (keep results/ but not embeddings in git)
data/processed/*.npy
data/processed/*.joblib

# Streamlit
.streamlit/

# Coverage
.coverage
htmlcov/
